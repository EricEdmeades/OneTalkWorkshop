# Copy to .env.local for local dev. In production, set these in
# Vercel → Project Settings → Environment Variables.

# ─ Analytics (client-side, exposed to browser via Vite's VITE_ prefix) ─
# Both are OPTIONAL. If unset, the corresponding tracker does not load
# and no analytics requests fire.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID. The Speaker Nation pixel is 515848329126231 —
# confirm before enabling in production.
VITE_META_PIXEL_ID=

# ─ Keap (server-side only, used by /api/subscribe-otw) ─
# Required for the "5 Steps to Overcoming Stage Fright" lead-magnet form
# to deliver into Keap. Reuses the same Keap account / credentials as
# ericedmeades.com. Locally, use `vercel dev` so the serverless function
# runs against these env vars.

# Keap REST API key (https://api.infusionsoft.com)
KEAP_API_KEY=

# Keap tag ID that triggers the 5 Steps email + worksheet delivery
# automation. Do NOT change this in Keap — the automation is wired to
# this exact tag. Default 1831 works as a fallback if unset.
KEAP_TAG_ID_STAGE_FRIGHT=1831

# ─ Stripe (server-side only, used by /api/create-checkout and /api/stripe-webhook) ─
# Live/test secret key from the Stripe Dashboard.
STRIPE_SECRET_KEY=

# Signing secret for the /api/stripe-webhook endpoint (Dashboard → Webhooks
# → your endpoint → Signing secret). Required to verify incoming events.
STRIPE_WEBHOOK_SECRET=

# Price IDs for the 4 combos. Amounts are identical for both workshop
# dates, so these 4 Prices are reused across August and September —
# which date it is gets carried in Checkout Session metadata instead.
STRIPE_PRICE_EARLY_FULL=
STRIPE_PRICE_RETAIL_FULL=
STRIPE_PRICE_EARLY_PLAN=
STRIPE_PRICE_RETAIL_PLAN=

# Keap tag IDs applied by /api/stripe-webhook once a Stripe Checkout
# Session completes, so we know which date a buyer registered for.
KEAP_TAG_ID_AUGUST=2008
KEAP_TAG_ID_SEPTEMBER=1825
